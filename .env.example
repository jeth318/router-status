# Web Push (VAPID). Generera nycklar: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:jesper.thornberg@me.com

# Kod du skriver in på webbsidan för att registrera en enhet / skicka testnotis.
# Lång slumpsträng, t.ex.: openssl rand -hex 24
ACCESS_TOKEN=

# Loggen går via stdout -> Vector -> VictoriaLogs. Extra vidarebefordran behövs normalt inte.
FORWARD_TYPE=none
# FORWARD_TYPE=victorialogs
# VICTORIALOGS_URL=http://victorialogs:9428
